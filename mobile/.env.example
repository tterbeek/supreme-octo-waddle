# Optional mobile/.env.local; public values only. Default build reads only the
# repository .env.development.local and remaps localhost to emulator10.0.2.2.
VITE_SUPABASE_URL=http://10.0.2.2:54321
VITE_SUPABASE_ANON_KEY=
VITE_SOCIAL_V2_ENABLED=true
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE=
# No service-role keys, client secrets, OpenAI keys or personal tokens here.
